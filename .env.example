# Match your local Postgres user/password, or use docker-compose.yml (postgres/postgres)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecommerce
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
PORT=5001

# Production CORS (Render): Vercel app URL(s), comma-separated. Add *.vercel.app for preview deploys.
# FRONTEND_URL=https://your-app.vercel.app,*.vercel.app

# Gmail SMTP — must be in backend/.env (NOT frontend/.env)
# App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-without-spaces
EMAIL_FROM_NAME=ecommerce
EMAIL_FROM=your-gmail@gmail.com

# Set to true for remote Postgres (e.g. Neon, Supabase)
# DATABASE_SSL=true

# Groq (preferred for AI) — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI fallback if GROQ_API_KEY is not set
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Cloudinary — device photos on sell/trade-in submissions
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
